# Copy to .env for local development. NEVER commit a real .env file.

# development | production  (production refuses to start without SECRET_KEY)
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_PATH=data/halloween.db

# Set to true in production (HTTPS). false only for http://localhost.
COOKIE_SECURE=false
SESSION_HOURS=8
# true only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
MAX_OPEN_REQUESTS_PER_IP=5
RETENTION_DAYS=180

# Initial payment settings — seeded into the DB on first start only.
# Afterwards edit them in the admin dashboard. Use placeholders here.
BANK_NAME=Example Bank (PLACEHOLDER)
BANK_ACCOUNT_HOLDER=Placeholder Account Holder
BANK_ACCOUNT_NUMBER=000-0000000 (PLACEHOLDER)
PAYMENT_AMOUNT=1000
PAYMENT_CURRENCY=MNT
PAYMENT_INSTRUCTIONS=Transfer the exact amount and put your request ID in the transfer description.
PAYMENT_INSTRUCTIONS_MN=Яг заасан дүнгээр шилжүүлж, гүйлгээний утга дээр хүсэлтийн дугаараа бичнэ үү.
REQUEST_EXPIRATION_HOURS=72
